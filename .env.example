# Browser/server
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info

# Identity middleware. Use `demo` on loopback for the Frontend/Backend/QA
# fixture users, `supabase` for hosted email/password authentication, or
# `legacy` to preserve the starter kit's shared-token mode.
AUTH_MODE=legacy
AUTH_SESSION_TTL_SECONDS=28800
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=false
ALLOW_INSECURE_DEMO_AUTH=false

# Legacy perimeter token. Required when AUTH_MODE=legacy and production listens
# beyond loopback. Use 24+ random URL-safe characters.
APP_AUTH_TOKEN=replace-with-a-long-random-demo-token

# Hosted Supabase connection values. Keep the secret key on the server only.
# Legacy anon/service-role keys are also accepted.
SUPABASE_URL=https://replace-with-your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# SUPABASE_ANON_KEY=replace-with-your-legacy-anon-key
SUPABASE_SECRET_KEY=replace-with-your-secret-key
# SUPABASE_SERVICE_ROLE_KEY=replace-with-your-legacy-service-role-key

# Volcengine Ark. ARK_MODEL is an endpoint/model ID that supports the
# OpenAI-compatible Responses API, for example ep-xxxxxxxx.
ARK_API_KEY=replace-with-your-ark-api-key
ARK_MODEL=ep-replace-with-your-endpoint-id
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# LOCAL DEBUGGING ONLY. Setting this to true forwards ARK_API_KEY and
# ARK_MODEL into the Agent Runtime container. That exposes the long-lived Ark
# key to the Agent container and invalidates the secure Runtime credential
# isolation claim. Keep false outside disposable local debugging.
LOCAL_INSECURE_RUNTIME_KEY_PASSTHROUGH=false
# Direct ModelArk calls from that disposable container also require network
# access. This disables the Runtime's --network none boundary. Keep false unless
# you explicitly accept both risks for a local demo.
LOCAL_INSECURE_RUNTIME_NETWORK=false

# Runtime paths (Docker defaults are already correct).
APP_DATA_DIR=/app/data
AGENT_WORKSPACE_ROOT=/app/workspaces
CODEX_HOME=/app/codex-home
CODEX_BIN=codex.cmd
CONTAINER_CODEX_BIN=codex

# Codex runs inside the dedicated ECS/container boundary. Startup keeps
# workspace-write when Landlock is supported and falls back to
# danger-full-access inside the outer container on kernels without Landlock.
# The fallback has no per-Agent filesystem isolation; use a scoped demo model
# key and do not place unrelated credentials or data in this POC.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152

# Department workspaces require the disposable isolated Runtime. The legacy
# local-process runner is development/test compatibility only.
RUNTIME_PROVIDER=container
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000
